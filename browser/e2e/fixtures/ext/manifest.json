{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "1.0",
  "description": "Open Arc test extension",
  "key": "",
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Open Arc Test"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
